# Supabase — dùng CHUNG project với hns-crm/ketoan (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram — tạo bot qua @BotFather để lấy token
TELEGRAM_BOT_TOKEN=
# Tự đặt 1 chuỗi bí mật bất kỳ, dùng khi gọi setWebhook (secret_token) để xác thực request đến từ Telegram thật
TELEGRAM_WEBHOOK_SECRET=
# Username bot (không có @), vd "HNS_HRM_bot" — dùng để hiện link mời trong trang /lien-ket-telegram
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Supabase — dùng CHUNG project với hns-crm/ketoan (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram — tạo bot qua @BotFather để lấy token
TELEGRAM_BOT_TOKEN=
# Tự đặt 1 chuỗi bí mật bất kỳ, dùng khi gọi setWebhook (secret_token) để xác thực request đến từ Telegram thật
TELEGRAM_WEBHOOK_SECRET=

# URL app khi deploy (không có dấu / ở cuối) — bot dùng để dựng nút mở trang chấm công dạng Telegram Web App
NEXT_PUBLIC_APP_URL=https://hrm.hanoisuntravel.com

# OpenAI — dùng để bot Telegram tách dữ liệu từ tin nhắn xin nghỉ/đi muộn/về sớm... tự do trong nhóm HCNS
OPENAI_API_KEY=

# MISA AMIS Chấm công — Mã kết nối/Khóa bảo mật lấy tại phần mềm Chấm công > Thiết lập > Kết nối > API kết nối
# Dùng để cron /api/cron/misa-sync kéo dữ liệu chấm công thô về hàng ngày (xem TichHopAPIChamCong.md)
MISA_CLIENT_ID=
MISA_SECRET_KEY=
# Vercel Cron tự gửi header "Authorization: Bearer <CRON_SECRET>" khi gọi route cron — tự đặt 1 chuỗi bí mật bất kỳ
CRON_SECRET=

# Zalo Mini App (project riêng ihns-mini-app) — App Secret lấy tại trang quản lý ZaloApp trên developers.zalo.me
# Dùng để đổi "location token" (Mini App SDK getLocation() trả về) thành toạ độ thật — KHÔNG được đưa ra client.
ZALO_APP_SECRET_KEY=
